    dcterms:modified "2026-05-22T21:52:18.048000"^^xsd:dateTime ;
    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/haptic-interfaces>,
        <http://lifia.info.unlp.edu.ar/resource/tema/human-computer-interaction> ;
