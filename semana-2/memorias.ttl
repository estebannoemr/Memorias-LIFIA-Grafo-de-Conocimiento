<http://lifia.info.unlp.edu.ar/resource/tesis/integracion-de-diferentes-tecnicas-para-visualizar-la-influencia-de-regiones-de-una-imagen-en-su-clasificacion-por-una-red-neuronal> a bibo:Thesis ;
    lifia:career "Licenciatura en Informática, UNLP" ;
    lifia:coDirectorName "Gabriela Pérez" ;
    lifia:directorName "Claudia Pons" ;
    lifia:endDate "2024-06-24"^^xsd:date ;
    lifia:featured false ;
    lifia:hasCoDirector <http://lifia.info.unlp.edu.ar/resource/persona/gabriela-perez> ;
    lifia:hasDirector <http://lifia.info.unlp.edu.ar/resource/persona/claudia-pons> ;
