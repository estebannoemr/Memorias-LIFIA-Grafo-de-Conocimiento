    lifia:startDate "2024-04-10"^^xsd:date ;
    lifia:studentName "Horacio Pendentti" ;
    dcterms:abstract "El objetivo principal de esta investigación es definir un proceso integrado de desarrollo de software cuántico, que permita la construcción eficiente y efectiva de aplicaciones híbridas de alta calidad. En este punto valga la aclaración que el término “integrado” obedece a la necesidad de integrar los elementos de procesos inherentes al desarrollo de software tradicional con elementos específicos al desarrollo de software cuántico." ;
    dcterms:created "2026-05-20T15:37:55.704000"^^xsd:dateTime ;
    dcterms:identifier "0a319f69-7c95-47bc-b3f1-966e41b55058" ;
