        <http://lifia.info.unlp.edu.ar/resource/persona/luis-mariano-bibbo> ;
    lifia:producedPublication <http://lifia.info.unlp.edu.ar/resource/publicacion/69797207>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/75774219>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/aparicio_morales_2024>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/aparicio_morales_2024-1>,
