<http://lifia.info.unlp.edu.ar/resource/tesis/relacion-entre-las-decisiones-de-diseno-de-espacios-colaborativos-y-su-impacto-en-la-propagacion-de-las-fake-news> a bibo:Thesis ;
    lifia:career "Doctorado en Ciencias Informáticas, Facultad de Informática, UNLP" ;
    lifia:coDirectorName "Diego Torres" ;
    lifia:directorName "Alejandro Fernandez" ;
    lifia:featured false ;
    lifia:hasCoDirector <http://lifia.info.unlp.edu.ar/resource/persona/diego-torres> ;
    lifia:hasDirector <http://lifia.info.unlp.edu.ar/resource/persona/alejandro-fernandez> ;
    lifia:involvedMember <http://lifia.info.unlp.edu.ar/resource/persona/alejandro-fernandez>,
        <http://lifia.info.unlp.edu.ar/resource/persona/diego-torres> ;
    lifia:level "PhD" ;
    lifia:progress 25 ;
    lifia:relatedProject <http://lifia.info.unlp.edu.ar/resource/proyecto/diseno-participativo-de-aplicaciones-de-ciencia-ciudadana-y-gestion-del-conocimiento>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/ingenieria-de-software-centrada-en-el-usuario-de-plataformas-de-participacion-ciudadana-motorizadas-por-inteligencia-artificial>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/tecnicas-y-herramientas-de-ingenieria-de-software-para-el-desarrollo-agil-de-soluciones-colaborativas-basadas-en-crowdsourcing-y-colaboracion-modelos-e-inteligencia-artificial> ;
    lifia:relatedPublication <http://lifia.info.unlp.edu.ar/resource/publicacion/caiza2023design>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/caiza_2020> ;
    lifia:slug "relacion-entre-las-decisiones-de-diseno-de-espacios-colaborativos-y-su-impacto-en-la-propagacion-de-las-fake-news" ;
    lifia:startDate "2020-03-01"^^xsd:date ;
    lifia:studentName "Edison Gustavo Caiza Andrango" ;
    dcterms:abstract "Este trabajo se centra en analizar la relación entre las decisiones de diseño de espacios colaborativos y la propagación de noticias falsas. El trabajo busca caracterizar las noticias falsas y los entornos colaborativos en los que se difunden, definir métricas que permitan medir su impacto y proponer recomendaciones de diseño que contribuyan a reducir su circulación. La investigación combina revisión sistemática de literatura, minería de datos y trabajo experimental con bases de datos reales, abordando una problemática social urgente desde una perspectiva informática y colaborativa. El objetivo final es aportar herramientas teóricas y prácticas que permitan construir espacios digitales más resistentes a la desinformación." ;
    dcterms:created "2026-05-20T15:37:54.674000"^^xsd:dateTime ;
    dcterms:identifier "a412d77a-67f6-4015-a3a7-fac8165beb4d" ;
    dcterms:modified "2026-05-22T21:51:20.347000"^^xsd:dateTime ;
    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/diseno>,
        <http://lifia.info.unlp.edu.ar/resource/tema/espacios-colaborativos>,
        <http://lifia.info.unlp.edu.ar/resource/tema/noticias-falsas>,
        <http://lifia.info.unlp.edu.ar/resource/tema/technology-and-society> ;
    dcterms:title "Relación entre las decisiones de diseño de espacios colaborativos y su impacto en la propagación de las Fake News" .

