    lifia:slug "verificacion-de-modelos-independientes-de-la-plataforma-un-caso-de-estudio" ;
    lifia:startDate "2017-11-30"^^xsd:date ;
    lifia:studentName "Carolina Inés Actis" ;
    dcterms:abstract "En este trabajo se propone transformar de forma automática las restricciones OCL a especificaciones escritas en el .onguaje JML. De esta forma se podrán verificar las restricciones en tiempo de ejecución, y se podrá hacer un análisis estático de estas mediante el uso de probadores de teoremas implementados para JML." ;
    dcterms:created "2026-05-20T15:37:53.589000"^^xsd:dateTime ;
