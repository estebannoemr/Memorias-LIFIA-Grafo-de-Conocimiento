    lifia:hasProjectMember <http://lifia.info.unlp.edu.ar/resource/persona/alejandro-fernandez>,
        <http://lifia.info.unlp.edu.ar/resource/persona/claudia-pons>,
        <http://lifia.info.unlp.edu.ar/resource/persona/diego-torres>,
        <http://lifia.info.unlp.edu.ar/resource/persona/leandro-antonelli>,
        <http://lifia.info.unlp.edu.ar/resource/persona/matias-urbieta> ;
    lifia:producedPublication <http://lifia.info.unlp.edu.ar/resource/publicacion/bracco_2023>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/leutwyler_lezoche_panetto_torres_2023> ;
    lifia:relatedThesis <http://lifia.info.unlp.edu.ar/resource/tesis/drug-repurposing-utilizando-embeddings-sobre-grafos-de-conocimiento>,
        <http://lifia.info.unlp.edu.ar/resource/tesis/formal-methods-for-knowledge-extraction-and-reuse-from-heterogeneous-sources-applications-to-the-semantic-interoperability-of-distributed-architectures>,
        <http://lifia.info.unlp.edu.ar/resource/tesis/intelligent-formal-analysis-of-heterogeneous-data-for-semantic-web>,
        <http://lifia.info.unlp.edu.ar/resource/tesis/patrones-de-diseno-de-interfaces-web-personalizables-para-mejorar-la-solucion-de-tareas-complejas-en-un-sistema-de-servicio-al-cliente-en-linea-basado-en-chatbots> ;
    lifia:responsibleGroup "Responsable por Argentina: Leandro Antonelli - Responsable por Colombia: Cesar Collazos - Responsable por Francia: Pascale Zarate" ;
    lifia:slug "collaborative-group-decision-for-knowledge-acquisition-in-agriculture-using-ai-techniques" ;
    lifia:startDate "2022-03-01"^^xsd:date ;
    dcterms:abstract "Knowledge acquisition is a key step to understand the domain in order to make proposals to obtain better results. Natural Language Processing tools in combination with Machine Learning (both from the Artificial Intelligence field) can be used to analyze the narrative descriptions captured, in order to obtain an ontology representation of the knowledge acquired. Considering the agricultural context and the use of technology, knowledge acquisition should be done with tools that suit the characteristics of the stakeholders and provide the accuracy of knowledge description needed in a technological environment. We consider three aspects to be taken into account. Collaborative Knowledge Management (CKM) is considered as a process of collective resolution of problems where it is useful to memorize the process of making collective decisions and to structure the group interactions to facilitate problem solving and sharing of ideas. Then scenarios are widely used to capture the knowledge from the stakeholders. Finally, conflict resolution is a step to be considered in knowledge acquisition. It is crucial making the group decision process interactive, iterative, collaborative and participatory. Thus, a multi-criteria decision support system arises as a tool to support this process." ;
    dcterms:created "2026-05-20T15:37:52.064000"^^xsd:dateTime ;
    dcterms:identifier "a1163e89-91c6-471c-a024-02b060860699" ;
    dcterms:modified "2026-05-22T21:49:26.997000"^^xsd:dateTime ;
    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/artificial-intelligence>,
        <http://lifia.info.unlp.edu.ar/resource/tema/human-ai-collaboration>,
        <http://lifia.info.unlp.edu.ar/resource/tema/smart-agriculture> ;
    dcterms:title "Collaborative Group Decision for knowledge acquisition in agriculture using AI techniques" .

