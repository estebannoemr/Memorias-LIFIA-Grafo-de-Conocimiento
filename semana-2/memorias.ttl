        <http://lifia.info.unlp.edu.ar/resource/tema/software-cuantico>,
        <http://lifia.info.unlp.edu.ar/resource/tema/software-engineering> ;
    dcterms:title "Proceso Integrado de Desarrollo de Software Cuántico" .

