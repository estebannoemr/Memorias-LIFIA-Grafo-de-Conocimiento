    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/requirements-engineering> ;
    dcterms:title "Proceso de validación de requerimientos aplicando técnicas de procesamiento de lenguaje natural en un entorno colaborativo" .

