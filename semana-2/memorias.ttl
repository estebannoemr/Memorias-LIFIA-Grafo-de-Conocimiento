<http://lifia.info.unlp.edu.ar/resource/tesis/manipulacion-digital-de-prototipos-en-papel> a bibo:Thesis ;
    lifia:career "Licenciatura en Sistemas" ;
    lifia:coDirectorName "José Matías Rivero" ;
    lifia:directorName "Julián Grigera" ;
    lifia:endDate "2021-10-14"^^xsd:date ;
    lifia:featured false ;
    lifia:hasDirector <http://lifia.info.unlp.edu.ar/resource/persona/julian-grigera> ;
    lifia:involvedMember <http://lifia.info.unlp.edu.ar/resource/persona/julian-grigera> ;
    lifia:level "Undergraduate" ;
    lifia:relatedProject <http://lifia.info.unlp.edu.ar/resource/proyecto/evaluacion-y-reparacion-comunitaria-de-problemas-de-usabilidad-y-accesibilidad-en-aplicaciones-web-desktop-y-moviles>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/mejora-continua-de-experiencia-de-usuario-en-aplicaciones-web>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/ux-driven-development-monitorizacion-continua-de-la-experiencia-del-usuario-durante-el-desarrollo-y-mantenimiento-agil-de-aplicaciones-interactivas> ;
    lifia:slug "manipulacion-digital-de-prototipos-en-papel" ;
    lifia:startDate "2020-05-20"^^xsd:date ;
    lifia:studentName "Iriarte Bosnic, Marcos Matías y Taus, Johana Giselle" ;
    dcterms:abstract "Esta tesina busca revalorizar la utilización de prototipos en papel como una herramienta que puede ser de gran utilidad en las primeras etapas del diseño y desarrollo de un producto de software. Mediante los prototipos en papel podemos obtener un primer acercamiento al producto que necesitamos construir y así obtener de manera rápida una primera aproximación a los requerimientos finales del desarrollo. Por este motivo, mediante la manipulación digital de los prototipos en papel buscamos poder ofrecer nuevas funcionalidades a una herramienta tan sencilla, pero a la vez útil como son los prototipos en papel." ;
    dcterms:created "2026-05-20T15:37:54.745000"^^xsd:dateTime ;
    dcterms:identifier "fe71d196-9555-4406-ad49-d5f4f9fb3ad5" ;
    dcterms:modified "2026-05-22T21:50:10.806000"^^xsd:dateTime ;
    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/human-computer-interaction> ;
    dcterms:title "Manipulación digital de prototipos en papel" .

