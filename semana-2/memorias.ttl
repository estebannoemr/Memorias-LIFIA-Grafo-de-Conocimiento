<http://lifia.info.unlp.edu.ar/resource/tesis/computacion-cuantica-y-sus-recursos-en-la-ingenieria-de-software> a bibo:Thesis ;
    lifia:career "Doctorado en Ciencias Informáticas " ;
    lifia:directorName "Alejandro Fernandez" ;
    lifia:featured true ;
    lifia:hasDirector <http://lifia.info.unlp.edu.ar/resource/persona/alejandro-fernandez> ;
    lifia:hasStudent <http://lifia.info.unlp.edu.ar/resource/persona/marcos-guillermo-lammers> ;
    lifia:involvedMember <http://lifia.info.unlp.edu.ar/resource/persona/alejandro-fernandez>,
        <http://lifia.info.unlp.edu.ar/resource/persona/marcos-guillermo-lammers> ;
    lifia:level "PhD" ;
    lifia:otherAdvisors "Federico Holik" ;
    lifia:relatedProject <http://lifia.info.unlp.edu.ar/resource/proyecto/ingenieria-de-software-cuantico>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/optimizacion-y-recursos-en-la-computacion-cuantica-aplicada-a-la-ingenieria-de-software>,
        <http://lifia.info.unlp.edu.ar/resource/proyecto/ripaisc-red-iberoamericana-para-el-avance-de-la-ingenieria-de-software-cuantico> ;
    lifia:relatedPublication <http://lifia.info.unlp.edu.ar/resource/publicacion/75774219>,
        <http://lifia.info.unlp.edu.ar/resource/publicacion/lammers_holik_fernandez_2025> ;
    lifia:slug "computacion-cuantica-y-sus-recursos-en-la-ingenieria-de-software" ;
    lifia:startDate "2024-08-01"^^xsd:date ;
    lifia:studentName "Marcos Guillermo Lammers" ;
    dcterms:abstract "El objetivo de esta tesis es identificar y caracterizar distintos recursos en la computación cuántica teniendo en cuenta las limitaciones de los dispositivos disponibles en la era NISQ. Ejemplos de dichos recursos son el entrelazamiento, la no-localidad, y la contextualidad, así como el número de qubits y la coherencia con la cual funcionan. Con esto, hacer aportes en el desarrollo de un marco metodológico para que los profesionales de la ingeniería de software puedan tomar decisiones relativas a las necesidades de recursos cuánticos de sus algoritmos y hacer evaluaciones de hardware acorde." ;
    dcterms:created "2026-05-20T15:37:55.611000"^^xsd:dateTime ;
    dcterms:identifier "6b02da01-b99f-4998-8d66-1c99fa0dded6" ;
    dcterms:modified "2026-05-22T21:51:20.337000"^^xsd:dateTime ;
    dcterms:subject <http://lifia.info.unlp.edu.ar/resource/tema/computacion-cuantica>,
        <http://lifia.info.unlp.edu.ar/resource/tema/ingenieria-de-software>,
        <http://lifia.info.unlp.edu.ar/resource/tema/quantum-computing>,
        <http://lifia.info.unlp.edu.ar/resource/tema/recursos>,
        <http://lifia.info.unlp.edu.ar/resource/tema/software-engineering> ;
    dcterms:title "Computación Cuántica y sus Recursos en la Ingeniería de Software" .

